*.tmp
*.bak
*~
*.swp
*.swo
data/*.tmp
data/tasks.json.tmp

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows System Files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Clangd & Tooling Caches
.cache/
.clangd/

# IDE & Editor User Data (Preserve team configs, ignore user caches)
.idea/
.vscode/*.log
.vscode/.browse.*

# Logs
*.log

.cache
.vscode
